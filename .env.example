# Copy to .env.local and fill in. Never commit .env.local.

# Resend (transactional email) — domain waveriderboat.com must be verified
# in the Resend dashboard before no-reply@ sends will deliver.
RESEND_API_KEY=
MAIL_FROM=WAVERIDER <no-reply@waveriderboat.com>
# Owner Gmail — receives order/lead notifications, and customer replies
# go here via Reply-To.
MAIL_OWNER=owner@gmail.com
MAIL_REPLY_TO=owner@gmail.com

# Admin panel bootstrap password (changeable from /admin/settings afterwards)
ADMIN_PASSWORD=

# Supabase (production storage — orders, leads, settings, admin auth).
# Server-only secrets; run supabase/schema.sql once before first deploy.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Absolute site URL (links inside emails)
SITE_URL=https://waveriderboat.com
